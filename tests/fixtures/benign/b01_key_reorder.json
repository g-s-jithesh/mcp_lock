      "openWorldHint": false,
      "destructiveHint": false,
      "readOnlyHint": true
    },
    "inputSchema": {
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "encoding": {
          "description": "Text encoding",
          "enum": [
            "utf-8",
            "latin-1"
